.venv/
.build-venv/
__pycache__/
*.pyc
.pytest_cache/

# setuptools regenerates this beside the package on every `pip install -e .`,
# so a tracked copy is stale by the time it lands, and CONTRIBUTING's own setup
# step dirtied a fresh clone. Nothing in the repo reads the checked-in copy.
*.egg-info/

# PyInstaller desktop-app build artifacts
/dist/
/build/MindHive/
/*.spec

# Linked git worktrees, including the per-task ones MN-9's orchestrator creates.
# This lived only in .git/info/exclude, which is local and does not travel — so on
# any other clone an agent's worktree showed up as untracked changes in the parent
# repo, and this project's own change-log detection reads git status.
.claude/worktrees/

# Lane checkouts the lintester mission pipeline creates (.worktrees/lane-N).
# Same reason .claude/worktrees/ is here: a linked worktree left in the parent
# repo shows up as untracked changes, and this project reads git status.
.worktrees/
